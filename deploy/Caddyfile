{
    email {$ACME_EMAIL}
    admin off
}

{$DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=15552000"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "same-origin"

    request_body {
        max_size 65536
    }
    # Worker authentication is available only over the private Compose network.
    @agent_api path /api/voice-agent/*
    handle @agent_api {
        respond 404
    }
    handle {
        basic_auth {
            {$BETA_USER} {$BETA_PASSWORD_HASH}
        }
        reverse_proxy app:8000 {
            header_up -Authorization
        }
    }
}
