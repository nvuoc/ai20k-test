# Copy through: bash deploy/setup.sh. Edit only deploy/.env on the VPS.
# DOMAIN is a hostname, without https://, port or trailing slash.
DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com
BETA_USER=beta
# Generated by setup.sh. Single quotes preserve the dollar signs in bcrypt.
BETA_PASSWORD_HASH=''
APP_SECRET=
PARROTGO_IMAGE=parrotgo:local

# Voice mode: setup.sh enables the voice Compose profile when VOICE_ENABLED=true.
VOICE_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=parrotgo-booking
# Generated by setup.sh; shared only between API and the voice worker.
VOICE_AGENT_SECRET=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
# Leave blank to derive the correct synthesis URL from AZURE_SPEECH_REGION.
AZURE_TTS_ENDPOINT=

# Real external APIs, but bookings remain sandbox/demo bookings.
# Use fixture_demo for a first offline check without API credentials.
APP_PROFILE=chat_sandbox
BRAND_NAME=ParrotGo
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_REASONING_EFFORT=low
GROQ_RPM=30
GROQ_TPM=8000
GROQ_TIMEOUT_SECONDS=8
LLM_FALLBACK_ENABLED=true
LLM_ALLOW_DEGRADED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_RPM=15
GEMINI_TIMEOUT_SECONDS=12
LLM_TIMEOUT_SECONDS=25
MAX_LLM_CALLS_PER_TURN=2
MAPS_PROVIDER=vietmap
VIETMAP_API_KEY=
TRAFFIC_ENABLED=true
TRAFFIC_TTL_SECONDS=60
LOCATION_CONFIRMATION_ENABLED=true
AREA_ASSISTANCE_ENABLED=false
# No free weather API in this deploy preset; enable your licensed provider separately.
WEATHER_PROVIDER=disabled

# Admission limits count new sessions/messages/actions, not polling or exact retries.
ADMISSION_LIMITS_ENABLED=false
# Model quotas above must match your own API account; these are local ceilings.
MAX_REQUEST_BODY_BYTES=65536
INBOUND_OWNER_RPM=30
INBOUND_GLOBAL_RPM=120
MAX_SESSIONS_PER_OWNER=20
MAX_SESSIONS_TOTAL=2000
MAX_PENDING_PER_SESSION=5
MAX_PENDING_TOTAL=100
WORKER_CONCURRENCY=4

# architecture_fixed.md: versioned per-km KB and reviewed Mega POI defaults.
KNOWLEDGE_BASE_PATH=
MEGA_POI_PATH=
# VEHICLE_CATALOG_PATH / PRICING_PATH / assistance flags are legacy settings.
# Current runtime always confirms slots and does not charge area assistance fees.
