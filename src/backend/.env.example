APP_PROFILE=chat_sandbox
VOICE_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=parrotgo-booking
# Same random secret (at least 32 characters) in API and agent worker.
VOICE_AGENT_SECRET=
# Agent worker connects to this backend URL, not to a separate booking database.
VOICE_API_URL=http://127.0.0.1:8000
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
# Optional custom TTS synthesis URL; not the generic Cognitive Services root.
AZURE_TTS_ENDPOINT=
APP_SECRET=
BUSINESS_DB_PATH=data/app.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
# New deployments use Groq first. Explicit LLM_PROVIDER=gemini preserves Gemini-only mode.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Set quotas from your Groq account; these are conservative local planning limits.
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RATE_DB_PATH=data/groq_rate.sqlite
GROQ_TIMEOUT_SECONDS=8
LLM_FALLBACK_ENABLED=true
# Config/auth failures only use fallback when degraded mode is explicitly enabled.
LLM_ALLOW_DEGRADED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15
GEMINI_RATE_DB_PATH=data/gemini_rate.sqlite
GEMINI_TIMEOUT_SECONDS=12
LLM_TIMEOUT_SECONDS=25
MAX_LLM_CALLS_PER_TURN=2
MAPS_PROVIDER=vietmap
VIETMAP_API_KEY=
QUOTE_TTL_SECONDS=120
BRAND_NAME=ParrotGo
WEATHER_PROVIDER=open_meteo
OPEN_METEO_API_KEY=
WEATHER_CACHE_SECONDS=900
INQUIRY_TTL_SECONDS=600
READ_TIMEOUT_SECONDS=5
READ_DEADLINE_SECONDS=15
# Optional: reviewed local aliases and an operational catalog/tariff.
LOCAL_ALIAS_PATH=
VEHICLE_CATALOG_PATH=
PRICING_PATH=
LOCATION_CONFIRMATION_ENABLED=true
TRAFFIC_ENABLED=true
TRAFFIC_TTL_SECONDS=60
# Reviewed representative points and assistance prices/limits; assistance stays off by default.
SERVICE_AREA_PATH=
ASSISTANCE_POLICY_PATH=
AREA_ASSISTANCE_ENABLED=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
ADMISSION_LIMITS_ENABLED=true

# architecture_fixed.md: versioned per-km KB and reviewed Mega POI defaults.
KNOWLEDGE_BASE_PATH=
MEGA_POI_PATH=
# VEHICLE_CATALOG_PATH / PRICING_PATH / assistance flags are legacy settings.
# Current runtime always confirms slots and does not charge area assistance fees.
